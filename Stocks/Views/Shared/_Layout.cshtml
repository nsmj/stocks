<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Stocks</title>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/Stocks.styles.css" asp-append-version="true" />
</head>

<body>
  <header class="app-header">
    <nav class="navbar navbar-expand-sm navbar-dark">
      <div class="container app-nav">
        <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
          <span class="app-brand-mark">S</span>
          <span>Stocks</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
          aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
          <ul class="navbar-nav app-nav-links">
            <li class="nav-item">
              <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Visão geral</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" asp-area="" asp-controller="Irpf" asp-action="Index">IRPF</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" asp-area="" asp-controller="Arquivos" asp-action="Importar">Importar arquivos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  </header>
  <div class="app-shell">
    <main role="main" class="container app-content">@RenderBody()</main>
  </div>

  <footer class="app-footer">
    <div class="container app-footer-content">
      <span>&copy; @DateTime.Now.Year Stocks</span>
      <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a>
    </div>
  </footer>
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
