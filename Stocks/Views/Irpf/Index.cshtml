@using Stocks.DTOs
@model Stocks.ViewModels.IrpfViewModel

<section class="page-intro">
  <div class="page-kicker">Declaração anual</div>
  <h1 class="page-title">Resumo do IRPF</h1>
  <p class="page-lead">Consulte os resultados das operações por ano e acompanhe os valores usados na sua declaração.</p>
</section>

<form class="filter-form" asp-controller="Irpf" asp-action="Index" method="get">
  <div class="form-group">
    <label class="form-label" for="ano">Ano de referência</label>
    <input id="ano" type="search" class="form-control" name="ano" value="@Model.AnoFiltrado" placeholder="Ex.: 2025" inputmode="numeric" />
  </div>
  <button type="submit" class="btn btn-primary">Consultar</button>
</form>

@if (@Model.AnoFiltrado is not null)
{
  <section class="result-highlight">
    <strong>Lucro com vendas abaixo de R$ 20 mil</strong>
    <span class="result-highlight-value">@Model.LucroVendasAbaixo20k</span>
  </section>
  <div class="table-wrap">
    <table class="table report-table">
      <thead>
        <tr>
          <th>mês</th>
          <th class='text-start' scope='col' colspan="4">
            Operações Comuns
          </th>
          <th class='text-start' scope='col' colspan="4">
            Day Trade
          </th>
          <th class='text-start' scope='col' colspan="4">
            FIIs
          </th>
        </tr>
        <tr>
          <th scope="col">Ref.</th>
          <th class='text-end' scope='col'>
            Total
          </th>
          <th class='text-end' scope='col'>
            Imposto Pago
          </th>
          <th class='text-end' scope='col'>
            IRRF
          </th>
          <th class='text-end' scope='col'>
            Prejuízo Acumulado
          </th>
          <th class='text-end' scope='col'>
            Total
          </th>
          <th class='text-end' scope='col'>
            Imposto Pago
          </th>
          <th class='text-end' scope='col'>
            IRRF
          </th>
          <th class='text-end' scope='col'>
            Prejuízo Acumulado
          </th>
          <th class='text-end' scope='col'>
            Total
          </th>
          <th class='text-end' scope='col'>
            Imposto Pago
          </th>
          <th class='text-end' scope='col'>
            IRRF
          </th>
          <th class='text-end' scope='col'>
            Prejuízo Acumulado
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th colspan="4" class="text-end year-summary">
            Prejuízo acumulado no ano anterior
          </th>
          <td class="text-end">
            @Model.PrejuizoAcumuladoAnoAnoAnteriorSwingTrade
          </td>
          <th colspan="3" class="text-end year-summary">
            Prejuízo acumulado no ano anterior
          </th>
          <td class="text-end">
            @Model.PrejuizoAcumuladoAnoAnteriorDayTrade
          </td>
          <th colspan="3" class="text-end year-summary">
            Prejuízo acumulado no ano anterior
          </th>
          <td class="text-end">
            @Model.PrejuizoAcumuladoAnoAnteriorFii
          </td>
        </tr>
        @for (int i = 1; i <= 12; i++)
        {
          <tr>
            <th class="month-cell">@i.ToString("00")</th>
            <td class="text-end swing-cell">
              @Model.SwingTradeRows?[i].Total
            </td>
            <td class="swing-cell" />
            <td class="text-end swing-cell">
              @Model.SwingTradeRows?[i].Irrf
            </td>
            <td class="text-end swing-cell">
              @Model.SwingTradeRows?[i].PrejuizoAcumulado
            </td>
            <td class="text-end">
              @Model.DayTradeRows?[i].Total
            </td>
            <td />
            <td>
              @Model.DayTradeRows?[i].Irrf
            </td>
            <td class="text-end">
              @Model.DayTradeRows?[i].PrejuizoAcumulado
            </td>
            <td class="text-end fii-cell">
              @Model.FiiRows?[i].Total
            </td>
            <td class="fii-cell" />
            <td class="text-end fii-cell">
              @Model.FiiRows?[i].Irrf
            </td>
            <td class="text-end fii-cell">
              @Model.FiiRows?[i].PrejuizoAcumulado
            </td>
          </tr>
        }
      </tbody>
    </table>

    @if (Model.PosicoesFimAno?.Any() == true)
    {
      <table class="table report-table secondary-table">
        <thead>
          <tr>
            <th colspan="3">Posições Ano Anterior</th>
          </tr>
          <tr>
            <th scope='col'>Código</th>
            <th scope='col'>Texto</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model.PosicoesFimAno)
          {
            <tr>
              <td class="text-end">
                @item.Codigo
              </td>
              <td class="text-start">
                @item.Texto
              </td>
            </tr>
          }
        </tbody>
      </table>
    }
  </div>
}